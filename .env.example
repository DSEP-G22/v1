APP_PROFILE=cpu

DATABASE_URL=sqlite+pysqlite:///./v1_data/app.db
OBJECT_STORE_ROOT=./v1_data/objects

BROKER=inprocess
KAFKA_BOOTSTRAP=localhost:9092

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
VLM_MODEL=llava:7b
LLM_TIMEOUT_S=60.0
LLM_NUM_CTX=8192

ASR_IMPL=faster_whisper
ASR_MODEL=base
VLM_IMPL=ollama
LLM_IMPL=ollama
EMBEDDER_IMPL=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CLASSIFIER_PATH=./models/artifacts/department_clf.joblib
VECTOR_STORE_PATH=./v1_data/vectors.json

AGGREGATION_WINDOW_S=120
ASR_LOW_CONFIDENCE_THRESHOLD=0.60
VLM_LOW_CONFIDENCE_THRESHOLD=0.55
DIAGNOSIS_MIN_CONFIDENCE=0.45
MAX_RETRIES=3

# static bearer tokens for workspace_api / admin_api roles (v1 auth stand-in)
AUTH_TOKEN_AGENT=dev-agent-token
AUTH_TOKEN_LEAD=dev-lead-token
AUTH_TOKEN_ADMIN=dev-admin-token
