# Backend image: FastAPI plus all pipeline services in one process.
# Multi-stage so the runtime layer carries no build toolchain.

FROM python:3.12-slim AS builder
WORKDIR /build
RUN pip install --no-cache-dir uv
COPY pyproject.toml ./
# Dependencies resolve into a venv that the runtime stage copies wholesale.
RUN uv venv /opt/venv && \
    uv pip install --python /opt/venv --no-cache \
        pydantic pydantic-settings fastapi "uvicorn[standard]" python-multipart \
        SQLAlchemy httpx PyYAML numpy python-ulid scikit-learn joblib

FROM python:3.12-slim
WORKDIR /app
ENV PATH="/opt/venv/Scripts:/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
COPY --from=builder /opt/venv /opt/venv

COPY libs/ ./libs/
COPY services/ ./services/
COPY runtime/ ./runtime/
COPY evaluation/ ./evaluation/
COPY scripts/ ./scripts/
COPY config/ ./config/
COPY models/prompts/ ./models/prompts/
COPY migrations/ ./migrations/
COPY pyproject.toml ./

RUN mkdir -p v1_data models/artifacts && \
    useradd --create-home --uid 1000 app && chown -R app:app /app
USER app

EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/admin/health')"

CMD ["python", "-m", "runtime.local"]
